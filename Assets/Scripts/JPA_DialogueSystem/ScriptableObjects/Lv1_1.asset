  _name: First
  _isInteractable: 1
  _lines:
  - name: ???
    sentence: I see you staring me down from all da way up there!
    modifiers:
    - type: 1
      value: 0.02
      triggerOrder: 0
  - name: ???
    sentence: 'Well, aren''t YOU a big one... '
    modifiers: []
  - name: Cellular
    sentence: I'm Cellular... The one-celled organism.
    modifiers: []
  - name: Cellular
    sentence: and I have a big favor to ask of you, friend.
    modifiers: []
  - name: Cellular
    sentence: You see, something's troublin' me for my whole life.
    modifiers: []
  - name: Cellular
    sentence: I'm too small and I'm insecure about it.
    modifiers: []
  - name: Cellular
    sentence: I need to grow. bigger.
    modifiers:
    - type: 3
      value: 0.25
      triggerOrder: 4
  - name: Cellular
    sentence: For that, I s'pose I need to consume some food.
    modifiers: []
  - name: Cellular
    sentence: Munch it real well, store it in my mitochondria.
    modifiers: []
  - name: Cellular
    sentence: ...and you'se gonna help me, capiche?
    modifiers: []
  - name: Cellular
    sentence: Or else, well. I hope you like sleepin' with em nanofishes
    modifiers: []
  - name: Cellular
    sentence: Now it ain't too hard, even a Prokaryote can do it.
    modifiers: []
  - name: Cellular
    sentence: Here, lemme show ya.
    modifiers: []
